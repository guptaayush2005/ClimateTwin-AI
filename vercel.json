{
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{data/**,models/**,backend/**,frontend/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
